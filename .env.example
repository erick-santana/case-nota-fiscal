# Copie para .env antes de `docker compose up`. Nenhuma credencial real aqui.

# Porta da API e porta de management (Actuator), lidas por application.properties.
SERVER_PORT=8080
MANAGEMENT_PORT=8081

# Tag de imagem consumida pelo compose (gerada por `./mvnw spring-boot:build-image`).
APP_VERSION=0.0.1-SNAPSHOT

# Emissor OIDC usado pela cadeia JWT (SecurityConfig) fora dos perfis local/test.
# Sem valor, o boot sobe normalmente e o JwtDecoder rejeita todo token (fail-closed).
OIDC_ISSUER_URI=

# SPEC-07 — outbox transacional (DynamoDB). O valor abaixo é para `./mvnw spring-boot:run`
# fora do compose; dentro do compose, DYNAMODB_ENDPOINT_OVERRIDE é sobrescrito para o nome do
# serviço (ver docker-compose.yml). Nenhuma credencial AWS real — DynamoDB Local não exige uma (P4).
DYNAMODB_ENDPOINT_OVERRIDE=http://localhost:8000
DYNAMODB_AUTO_CREATE_TABLE=true
